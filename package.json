{
  "name": "aionix-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise AI prompt guard (Manifest V3) with a hardware-aware 3-tier local DLP engine and benchmark workbench.",
  "repository": {
    "type": "git",
    "url": "https://github.com/tatkaal/Aionix-Sentinel.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:ext && npm run build:web",
    "build:ext": "tsx scripts/build-extension.mjs",
    "build:ext:test": "tsx scripts/build-extension.mjs --test",
    "build:web": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "tsx scripts/bench.ts",
    "bench:gate": "tsx scripts/bench.ts --gate",
    "measure:ext": "tsx scripts/measure-extension.ts",
    "report": "tsx scripts/report-results.ts",
    "data:models": "node scripts/fetch-models.mjs",
    "data:fst": "tsx scripts/build-medical-fst.ts",
    "data:vault": "tsx scripts/build-vault.ts",
    "data:datasets": "tsx scripts/fetch-datasets.ts",
    "data:icons": "node scripts/gen-icons.mjs",
    "setup": "npm run data:models && npm run data:fst && npm run data:vault && npm run data:datasets && npm run data:icons"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@orama/orama": "^3.1.18",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "onnxruntime-web": "^1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "onnxruntime-node": "^1.30.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
